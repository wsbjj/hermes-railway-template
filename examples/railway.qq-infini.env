# Railway Variables example: QQ Bot + InfiniAI / 无问芯穹
HERMES_GIT_REF=v2026.5.29
HERMES_HOME=/data/.hermes
HOME=/data

HERMES_INFERENCE_PROVIDER=custom
HERMES_MODEL=your-infini-model-id
