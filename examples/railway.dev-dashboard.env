HERMES_GIT_REF=v2026.5.29
HERMES_HOME=/data/.hermes
HOME=/data
TZ=Asia/Shanghai
HERMES_TIMEZONE=Asia/Shanghai
TERMINAL_CWD=/data/workspace

HERMES_INFERENCE_PROVIDER=custom
HERMES_MODEL=your-model-id
OPENAI_BASE_URL=https://your-openai-compatible-endpoint/v1
OPENAI_API_KEY=your-api-key

# Enable Hermes official Web Dashboard on Railway dev.
HERMES_DASHBOARD=1
HERMES_DASHBOARD_TUI=1
# Default: use the Dashboard assets prebuilt into the Docker image.
HERMES_DASHBOARD_SKIP_BUILD=true
# Required when Dashboard is exposed through the public status-page proxy.
HERMES_DASHBOARD_PROXY_USER=admin
HERMES_DASHBOARD_PROXY_PASSWORD=replace-with-a-long-random-password
# Status-page login session TTL. Defaults to one hour.
HERMES_DASHBOARD_SESSION_SECONDS=3600

# In status-page proxy mode, entrypoint enables Dashboard insecure mode by
# default so the status-page login is the only login prompt.
# Set HERMES_DASHBOARD_INSECURE=false only if you also want Hermes' OAuth/code gate.

# Pure web-chat dev mode. Set true only when using a separate test bot.
HERMES_GATEWAY_ENABLED=false
