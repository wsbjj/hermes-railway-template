# Railway Variables example: WeCom + InfiniAI / 无问芯穹
HERMES_GIT_REF=v2026.7.1
HERMES_HOME=/data/.hermes
HOME=/data

HERMES_INFERENCE_PROVIDER=custom
HERMES_MODEL=your-infini-model-id
OPENAI_BASE_URL=https://cloud.infini-ai.com/maas/v1
OPENAI_API_KEY=your-infini-api-key

WECOM_BOT_ID=your-wecom-bot-id
WECOM_SECRET=your-wecom-secret
WECOM_ALLOWED_USERS=user_id_1,user_id_2
