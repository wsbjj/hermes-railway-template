# Railway Variables example: WeChat / Weixin + custom OpenAI-compatible endpoint
HERMES_GIT_REF=v2026.9.14
HERMES_HOME=/data/.hermes
HOME=/data

HERMES_INFERENCE_PROVIDER=custom
HERMES_MODEL=your-model-id
OPENAI_BASE_URL=https://your-openai-compatible-endpoint/v1
OPENAI_API_KEY=your-api-key

# Hermes official WeChat adapter is Weixin (iLink Bot API).
# First complete QR login with `hermes gateway setup`, then paste account_id and token.
WEIXIN_ACCOUNT_ID=your-weixin-account-id
WEIXIN_TOKEN=your-weixin-bot-token
WEIXIN_ALLOWED_USERS=user_id_a,user_id_b
WEIXIN_DM_POLICY=allowlist
